{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "founder-os-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // D1 database created and migrated (migrations/0001_init.sql) directly via
  // the Cloudflare API. See the "Deploying to Cloudflare Workers" section in
  // README.md for the remaining deploy step.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founder-os-demo",
      "database_id": "7c92e361-eee1-4442-ab00-d48a6e930027"
    }
  ]
}
