{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "founder-os-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Created by `wrangler d1 create founder-os-demo` — replace database_id
  // with the id that command prints, then `wrangler d1 migrations apply DB`
  // to lay down the schema in migrations/. See the "Deploying to Cloudflare
  // Workers" section in README.md for the full walkthrough.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founder-os-demo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
